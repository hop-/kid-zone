; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Kid Zone"
config/description="A touch-first 8-bit learning game for young kids: math and words."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/quit_on_go_back=false
config/icon="res://icon.svg"

[autoload]

Settings="*res://autoload/settings.gd"
Content="*res://autoload/content.gd"
Art="*res://autoload/art.gd"
Audio="*res://autoload/audio.gd"
Router="*res://autoload/router.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[internationalization]

locale/translations=PackedStringArray("res://content/locale/ui.en.translation")

[rendering]

environment/defaults/default_clear_color=Color(0.15686275, 0.2, 0.43137255, 1)
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
